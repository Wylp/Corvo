{
  "sourceLanguage": "en",
  "strings": {
    "%@ is in use by another app. Still no shortcut.": {
      "comment": "Warning under the shortcut row when the system refused the combination and the user had already cleared the shortcut, so nothing is bound. %@ is the one they wanted."
    },
    "%@ is in use by another app. Still using %@.": {
      "comment": "Warning under the shortcut row when the system refused the combination. First %@ is the one the user wanted, second %@ is the one still bound."
    },
    "%@ needs ⌘, ⌥ or ⌃ — otherwise it would be swallowed everywhere.": {
      "comment": "Warning under the shortcut row when the user recorded a combination with no ⌘, ⌥ or ⌃. %@ is the combination they typed, which was never registered."
    },
    "A newer version of Corvo is available. Corvo will quit and reopen.": {
      "comment": "Tooltip on the Update button. Says the app will close, because it has to be gone for its own bundle to be replaced."
    },
    "A tag named “%@” already exists.": {
      "comment": "Inline error in the tag editor when the name already belongs to another tag. %@ is the name the user typed."
    },
    "Accessibility granted": {
      "comment": "Status line when Corvo may paste for the user."
    },
    "Accessibility pending": {
      "comment": "Status line when Accessibility permission is missing."
    },
    "Add": {
      "comment": "Button that confirms the new tag in the tag sheet."
    },
    "Add a tag": {
      "comment": "Title of the sheet that ⌘T opens to put a tag on the selected clipping."
    },
    "Add app…": {
      "comment": "Button that opens a file picker to add an app to the blocklist."
    },
    "Add this tag to the clippings already in your history that match": {
      "comment": "Tooltip of the “Apply to existing…” button in the tag editor."
    },
    "All": {
      "comment": "Tag sheet filter: show every tag, whether or not it has a rule."
    },
    "Any app": {
      "comment": "Option in the tag editor's source picker: the rule is not restricted to one app."
    },
    "Applies itself": {
      "comment": "VoiceOver label of the bolt icon marking a tag in the list that carries a rule."
    },
    "Apply this rule to what you already copied?": {
      "comment": "Title of the confirmation before the tag is applied retroactively."
    },
    "Apply to existing…": {
      "comment": "Button in the tag editor that starts the retroactive apply. The ellipsis says it opens a confirmation first."
    },
    "Apps": {
      "comment": "Key-hint label for ⌘↑↓, which walks the list of source apps in the sidebar."
    },
    "Ask me to name what it catches": {
      "comment": "Toggle in the tag editor: offer to name a clipping this tag claims."
    },
    "Asks GitHub once a day whether a newer release exists. No clipping and nothing that identifies you is sent.": {
      "comment": "Caption under the update switch, explaining the only network connection the app makes."
    },
    "Auto": {
      "comment": "Tag sheet filter: show only tags that carry a rule and apply themselves."
    },
    "Blocks nothing — not a bundle ID: %@": {
      "comment": "Warning under the blocklist. %@ is the quoted, comma-separated lines that are not bundle ids and are therefore enforcing nothing."
    },
    "Blue": {
      "comment": "Tag colour name. VoiceOver label of the colour swatch in the tag editor."
    },
    "Cancel": {
      "comment": "Button that dismisses the tag sheet or the rename sheet without changing anything."
    },
    "Check for updates": {
      "comment": "Switch in Settings > General. The only setting in the app that turns a network connection on or off."
    },
    "Check now": {
      "comment": "Button that runs the update check immediately instead of waiting for the daily one."
    },
    "Checking…": {
      "comment": "Shown while the update check is in flight."
    },
    "Choose": {
      "comment": "Confirmation button of that panel. Picks the app for the rule; it does not launch it."
    },
    "Choose an app…": {
      "comment": "Last row of the tag editor's source picker. Opens a panel listing every installed app. The ellipsis says a panel follows."
    },
    "Choose the app this rule should match.": {
      "comment": "Message shown inside the app panel opened from the tag editor."
    },
    "Click, then type the shortcut you want": {
      "comment": "Tooltip of the shortcut recorder while it is idle."
    },
    "Close": {
      "comment": "Key-hint label for esc, which closes the panel."
    },
    "Color": {
      "comment": "Field label in the tag editor. US spelling, like every other string here."
    },
    "Copied": {
      "comment": "The HUD shown after one clipping goes to the clipboard. The panel has closed by then, so this is the only confirmation there is."
    },
    "Copied %lld clippings": {
      "comment": "The same HUD for a multiple selection. Only ever reached with 2 or more, so the noun is plural in the source."
    },
    "Copied, but not pasted": {
      "comment": "Alert title after Enter when Accessibility permission is missing: the item was copied but not pasted."
    },
    "Copy": {
      "comment": "Keycap rail label: ⌘C copies the selected clipping without pasting it."
    },
    "Copy something and come back.": {
      "comment": "Empty-history hint under the 'Nothing here yet' title."
    },
    "Copy that card": {
      "comment": "Keycap rail label for ⌘1-9 while confirming copies rather than pastes. The paste wording is the other entry."
    },
    "Corvo": {
      "comment": "App name. Never translated.",
      "shouldTranslate": false
    },
    "Corvo %@ is available. You have %@.": {
      "comment": "Update status. First %@ is the newest release's version, second is the one running."
    },
    "Corvo %@ is the newest release.": {
      "comment": "Update status when nothing newer exists. %@ is the running version."
    },
    "Corvo %@.": {
      "comment": "Update status before any check has run. %@ is the running version."
    },
    "Corvo Settings": {
      "comment": "Title of the Settings window."
    },
    "Corvo is running with no icon and no shortcut. Opening Corvo again opens Settings.": {
      "comment": "Caption under the menu bar switch while the icon is hidden and the user has also cleared the shortcut, so reopening the app is the only way back."
    },
    "Corvo is running with no icon. %@ opens the history; opening Corvo again opens Settings.": {
      "comment": "Caption under the menu bar switch while the icon is hidden. %@ is the shortcut currently bound, read live so it cannot go stale when the user rebinds."
    },
    "Corvo keeps running and %@ still opens the history. To get Settings back open Corvo again from the Applications folder.": {
      "comment": "Confirmation body before hiding the menu bar icon. %@ is the shortcut currently bound."
    },
    "Corvo keeps running, but with no icon and no shortcut there is nothing left that opens the history. Open Corvo again from the Applications folder to get Settings back, and set a shortcut there.": {
      "comment": "Caption under the menu bar switch while the icon is hidden and the user has also cleared the shortcut, so reopening the app is the only way back."
    },
    "Corvo needs Accessibility permission to paste straight into the app you were using. The content is already on your clipboard — paste it with ⌘V.\n\nIf Corvo is already switched on in that list, macOS is holding a permission for an older copy of the app: select Corvo, remove it with the − button, then add it again.": {
      "extractionState": "manual",
      "localizations": {}
    },
    "Corvo will delete anything older than ^[%lld day](inflect: true), however few are left. Pinned and tagged clippings are never deleted. Corvo has no undo.": {
      "comment": "Confirmation body when only the age rule is on. %lld is the number of days; the inflect markup makes the noun agree with it."
    },
    "Corvo will keep the newest ^[%lld clipping](inflect: true) and delete anything older than ^[%lld day](inflect: true). Pinned and tagged clippings are never deleted. Corvo has no undo.": {
      "comment": "Body of the lowered-limit confirmation. First %lld is the item limit, second is the age limit in days."
    },
    "Corvo will keep the newest ^[%lld clipping](inflect: true), whatever their age. Pinned and tagged clippings are never deleted. Corvo has no undo.": {
      "comment": "Confirmation body when only the count rule is on. %lld is the ceiling; the inflect markup makes the noun agree with it."
    },
    "Could not reach GitHub. Corvo %@.": {
      "comment": "Update status when the check did not complete. Deliberately not phrased as an error: nothing is wrong with the app and there is nothing to fix. %@ is the running version."
    },
    "Could not save this tag. Nothing was changed.": {
      "comment": "Inline error next to the Save button when the write to the database failed."
    },
    "Create and add": {
      "comment": "Button that writes the tag being defined and puts it on the selected clippings. Says 'Add' instead when a tag in the list is highlighted."
    },
    "Delete": {
      "comment": "Key-hint label for the delete key, which removes the selected item."
    },
    "Delete after": {
      "comment": "Label of the field that sets how long a clipping is kept."
    },
    "Delete clippings now?": {
      "comment": "Title of the confirmation shown when the user lowers a retention limit."
    },
    "Delete tag": {
      "comment": "Tooltip and VoiceOver label of the − button under the tag list."
    },
    "Delete the tag “%@”?": {
      "comment": "Title of the delete confirmation. %@ is the tag's name."
    },
    "Done": {
      "comment": "Keycap rail label: esc closes the tag manager."
    },
    "Edit tags": {
      "comment": "Keycap rail label: ⌘⇧T opens the tag manager."
    },
    "Edit tags and rules": {
      "comment": "VoiceOver label of the sidebar button that opens the tag manager."
    },
    "Edit tags and rules (⌘⇧T)": {
      "comment": "Tooltip of the sidebar button that opens the tag manager."
    },
    "Every tag you have is already on this.": {
      "comment": "Shown in place of the tag list when nothing is left to add to the selection."
    },
    "From app": {
      "comment": "Label of the tag editor field holding the source-app half of the rule."
    },
    "General": {
      "comment": "Sidebar pane holding launch-at-login and the menu bar icon."
    },
    "Green": {
      "comment": "Tag colour name. VoiceOver label of the colour swatch in the tag editor."
    },
    "Hide": {
      "comment": "Confirming button of the hide-the-icon alert. Removes the icon from the menu bar."
    },
    "Hide the menu bar icon?": {
      "comment": "Title of the confirmation shown before the menu bar icon is hidden."
    },
    "History": {
      "comment": "Section title for the retention limits."
    },
    "Hold and click to select several": {
      "comment": "Key-hint label for ⇧⌘ in the panel's shortcut rail. Unlike the other hints, the key performs nothing on its own — it qualifies the click."
    },
    "Ignore": {
      "comment": "Confirmation button of the app picker. Adds the app to the blocklist."
    },
    "Ignored apps": {
      "comment": "Section title for the list of apps Corvo never records."
    },
    "Ignored apps, one bundle ID per line": {
      "comment": "VoiceOver label for the blocklist text editor."
    },
    "Image unavailable": {
      "comment": "Shown on a card whose image file could not be read from disk."
    },
    "Image, %lld by %lld pixels": {
      "comment": "VoiceOver label for the picture in the hover preview. The dimensions are the file's true size in pixels, which is the one fact the picture itself cannot state now that the preview has no footer."
    },
    "Keep at most": {
      "comment": "Label of the field that sets the maximum number of clippings."
    },
    "Launch at login": {
      "comment": "Toggle that registers Corvo as a login item."
    },
    "Manual": {
      "comment": "Tag sheet filter: show only tags with no rule, applied by hand."
    },
    "Matches %lld+ clippings — only the %lld most recent were checked.": {
      "comment": "Status under the pattern field when the preview filled its scan cap, so there may be older matches it never looked at. First %lld is how many were found, second is the cap."
    },
    "Matches ^[%lld clipping](inflect: true) in your history.": {
      "comment": "Status under the pattern field. %lld is how many stored clippings the rule claims."
    },
    "Mint": {
      "comment": "Tag colour name. VoiceOver label of the colour swatch in the tag editor."
    },
    "Name": {
      "comment": "Label and placeholder of the tag name field, and of the clipping name field in the rename sheet."
    },
    "Name it": {
      "comment": "Button on the notification that reveals the text field for naming a clipping."
    },
    "Name this (⌘R)": {
      "comment": "Shown on a card whose rule tag asks for a name and that has none yet. ⌘R opens the rename sheet."
    },
    "Name this clipping": {
      "comment": "Title of the naming notification, and the heading of the ⌘R rename sheet."
    },
    "Needs Accessibility permission, which is not granted yet.": {
      "comment": "Warning under that switch when it is on and the permission is missing — the setting promises something the app cannot currently do."
    },
    "New": {
      "comment": "Keycap rail label: ⌘N makes a tag."
    },
    "New tag": {
      "comment": "Title of the sheet that adds a tag to the selected item."
    },
    "No matches": {
      "comment": "Title shown when the search finds nothing."
    },
    "No rule yet — this tag is only applied by hand.": {
      "comment": "Status under the pattern field when the tag carries no rule at all."
    },
    "No tag matches this search.": {
      "comment": "Shown in place of the tag list when the search or the filter excludes everything."
    },
    "No tags yet": {
      "comment": "Empty state of the tag list."
    },
    "No tags yet. Make the first one on the right.": {
      "comment": "Shown in place of the tag list when none exist."
    },
    "None": {
      "comment": "Recorder button label when no global shortcut is bound. The user cleared it with ⌫, and the menu bar item is then the only way in."
    },
    "Not a valid pattern. Check the brackets and escapes.": {
      "comment": "Status under the pattern field when the regular expression does not compile."
    },
    "Not now": {
      "comment": "Alert button that dismisses the missing-permission alert without opening Settings."
    },
    "Nothing here yet": {
      "comment": "Title shown when the history is empty."
    },
    "Nothing is ever deleted. The history grows until you delete clippings yourself.": {
      "comment": "Caption under the History section when both retention rules are switched off."
    },
    "Nothing left to paste": {
      "extractionState": "manual",
      "localizations": {}
    },
    "Nothing you have copied matches yet. New copies still can.": {
      "comment": "Status under the pattern field when a valid rule matches nothing stored yet."
    },
    "OK": {
      "extractionState": "manual",
      "localizations": {}
    },
    "On all %lld clippings": {
      "comment": "Label above the tags attached to EVERY selected clipping. A tag on only some of them is deliberately not listed, which is what 'all' carries. Only ever reached with 2 or more."
    },
    "On this clipping": {
      "comment": "Label above the tags already attached to the one selected clipping."
    },
    "One bundle ID per line. Nothing copied in these apps is kept.": {
      "comment": "Caption under the blocklist."
    },
    "Open Login Items": {
      "comment": "Button that opens System Settings at the Login Items list."
    },
    "Open Settings": {
      "comment": "Alert button that opens System Settings at the Accessibility panel."
    },
    "Open panel": {
      "comment": "Label of the row holding the shortcut recorder, in the Shortcut section."
    },
    "Opens Corvo from any app. Needs ⌘, ⌥ or ⌃.": {
      "comment": "Caption under the shortcut row. The three glyphs are modifier keys and are not translated; ⇧ alone is refused because it is how a capital letter is typed."
    },
    "Optional": {
      "comment": "Marker beside a tag field that can be left alone."
    },
    "Orange": {
      "comment": "Tag colour name. VoiceOver label of the colour swatch in the tag editor."
    },
    "Paste": {
      "comment": "Key-hint label for return, which pastes the selected item."
    },
    "Paste into the app you came from": {
      "comment": "Switch in Settings > General. Off, confirming a clipping copies it; on, Corvo presses ⌘V for you."
    },
    "Paste that card": {
      "comment": "Key-hint label for ⌘1-9, which pastes the card wearing that number."
    },
    "Paste with command %lld": {
      "comment": "Accessibility label of the number badge on a card. %lld is 1 through 9, the digit pressed with ⌘ to paste it."
    },
    "Pasted %lld of %lld": {
      "comment": "Alert title when a multi-clipping paste only partly went through. First number is how many were pasted, second is how many were asked for."
    },
    "Pattern": {
      "comment": "Label and placeholder of the tag editor's regular-expression field."
    },
    "Permissions": {
      "comment": "Section title for the Accessibility permission status."
    },
    "Pick": {
      "comment": "Keycap rail label: the up and down arrows move through the list of tags."
    },
    "Pin": {
      "comment": "Key-hint label for Command-P, which pins the selected item."
    },
    "Pink": {
      "comment": "Tag colour name. VoiceOver label of the colour swatch in the tag editor."
    },
    "Pinned": {
      "comment": "Accessibility label for the pin badge on a card."
    },
    "Pinned or tagged clippings never expire, and do not count towards the limit.": {
      "comment": "Caption under the retention fields."
    },
    "Press ⌘N to make one.": {
      "comment": "Second line of the empty tag list, naming the shortcut that creates a tag."
    },
    "Purple": {
      "comment": "Tag colour name. VoiceOver label of the colour swatch in the tag editor."
    },
    "Quit": {
      "comment": "Menu bar item that terminates the app."
    },
    "Red": {
      "comment": "Tag colour name. VoiceOver label of the colour swatch in the tag editor."
    },
    "Registered, but switched off in System Settings.": {
      "comment": "Warning under the login toggle when macOS has the item registered but disabled."
    },
    "Remove %@": {
      "comment": "Accessibility label of the × on a tag chip. %@ is the tag's name."
    },
    "Remove this tag from the clipping": {
      "comment": "Tooltip of the × on a tag chip in the panel."
    },
    "Required": {
      "comment": "Marker beside a tag field that has to be filled in."
    },
    "Reset to ⌘⇧V": {
      "comment": "Button that puts the shortcut back to the default. Shown only when the current binding is not the default. ⌘⇧V is the key combination itself and is not translated."
    },
    "Sample of matching clippings": {
      "comment": "VoiceOver label of the three-line preview of what the pattern matches."
    },
    "Save": {
      "comment": "Button in the tag editor that writes the tag, the ⏎ keycap rail label, and the button that saves a clipping's name from both the rename sheet and the notification."
    },
    "Save and apply": {
      "comment": "Button in the retroactive-apply confirmation: save the tag and tag the matches."
    },
    "Search content or app…": {
      "comment": "Placeholder of the search field at the top of the panel."
    },
    "Search tags": {
      "comment": "Placeholder of the field that narrows the list of existing tags."
    },
    "Settings": {
      "comment": "Accessibility label of the gear button in the panel's search row, which opens the Settings window."
    },
    "Settings (⌘,)": {
      "comment": "Tooltip of the gear button in the panel's search row. ⌘, is the key combination and is not translated."
    },
    "Settings…": {
      "comment": "Menu bar item that opens the Settings window."
    },
    "Shortcut": {
      "comment": "Section title for the global shortcut that opens the panel."
    },
    "Shortcut for opening the panel": {
      "comment": "Accessibility label of the shortcut recorder button."
    },
    "Show": {
      "comment": "Accessibility label of the tag sheet's All/Auto/Manual filter. Not drawn on screen."
    },
    "Show History": {
      "comment": "Menu bar item that opens the floating panel."
    },
    "Show icon in menu bar": {
      "comment": "Toggle that puts Corvo's icon in the menu bar, or takes it out."
    },
    "Showing the first %lld of %lld characters": {
      "comment": "Last line of the hover preview's excerpt, when the clipping was too long to render whole. First number is the preview's budget, second is the clipping's real length."
    },
    "Shown on the card and searchable. Clear it to remove the name.": {
      "comment": "Helper text under the field in the ⌘R rename sheet."
    },
    "Sources": {
      "comment": "Sidebar section listing the apps the clippings came from."
    },
    "Tag": {
      "comment": "Key-hint label for Command-T, which tags the selected item."
    },
    "Tag %lld clippings": {
      "comment": "Title of the tag sheet when several clippings are selected. Only ever reached with 2 or more, so the noun is plural in the source; a language needing more plural forms gets them as variations here."
    },
    "Tag name": {
      "comment": "Placeholder of the text field in the new-tag sheet."
    },
    "Tag this clipping": {
      "comment": "Title of the tag sheet when one clipping is selected."
    },
    "Tagged %@": {
      "comment": "Subtitle of the naming notification, saying which rule tag claimed the clipping. %@ is the tag name."
    },
    "Tags": {
      "comment": "Sidebar section listing the tags in use."
    },
    "Tags you add with ⌘T show up here": {
      "comment": "Placeholder in the tag row across the top of the panel while no tag exists yet. Says what the row is for rather than leaving a bare band that reads as broken."
    },
    "That app carries no identifier, so no rule can name it. Choose another.": {
      "comment": "Inline error under the tag editor's source picker when the chosen app bundle has no bundle identifier to key the rule on."
    },
    "The clipboard holds one thing at a time, so several clippings go over joined into one. Images have no text to join, so they are left out — paste them one at a time.": {
      "comment": "Alert body explaining why images were left out of a multi-clipping paste."
    },
    "The file this clipping points at has been moved or deleted. Corvo keeps a reference to files rather than a copy of them, so there is nothing left to put on the clipboard.": {
      "extractionState": "manual",
      "localizations": {}
    },
    "The tag is saved and added to ^[%lld clipping](inflect: true) already in your history. Corvo has no undo.": {
      "comment": "Message of the retroactive-apply confirmation. %lld is how many clippings will be tagged."
    },
    "The tag is saved and added to the ^[%lld most recent matching clipping](inflect: true) already in your history. Older ones are not tagged. Corvo has no undo.": {
      "comment": "Alert body for applying a tag retroactively when the scan hit its cap. %lld is the cap; the inflect markup makes the noun agree with it."
    },
    "This file no longer exists": {
      "comment": "VoiceOver label for the question-mark glyph in the hover preview of a file clipping whose original file is gone from disk. The card says 'Unavailable'."
    },
    "This pattern can take hours on some clippings. The cause is almost always a repeat wrapped in another repeat — (a+)+ or (\\s+)+ — where the inner + or * already covers the outer one. Remove the outer repeat.": {
      "comment": "Status under the pattern field when the regular expression compiles but backtracks catastrophically. It names the shape to look for and what to remove, because \"invalid pattern\" tells someone staring at a regex that compiles nothing they can act on."
    },
    "Try another word, or clear the search.": {
      "comment": "Hint under the 'No matches' title."
    },
    "Type a shortcut, or press Escape to cancel": {
      "comment": "Tooltip of the shortcut recorder while it is armed."
    },
    "Type a shortcut…": {
      "comment": "Recorder button label while it is armed and no modifier is being held yet."
    },
    "Unavailable": {
      "comment": "Badge on a file card whose original file is no longer on disk."
    },
    "Unknown": {
      "comment": "Fallback shown on a card when the source app was not recorded."
    },
    "Update": {
      "comment": "Button beside the gear in the panel, shown only when a newer release exists. Pressing it runs the upgrade."
    },
    "Update Corvo": {
      "comment": "Accessibility label of that button."
    },
    "Updating quits Corvo and opens it again. macOS may ask for Accessibility permission afterwards: the new build is a different binary as far as it is concerned.": {
      "comment": "Caption shown in Settings only while an update is available, before the user presses anything."
    },
    "What is this?": {
      "comment": "Placeholder in the notification's text field, where the user types the name."
    },
    "When it catches something": {
      "comment": "Field label above the switch that asks to be prompted for a name."
    },
    "Without it, Corvo copies but does not paste for you.": {
      "comment": "Caption under the Accessibility status."
    },
    "Yellow": {
      "comment": "Tag colour name. VoiceOver label of the colour swatch in the tag editor."
    },
    "Your tags": {
      "comment": "Label above the list of existing tags that can be added."
    },
    "^[%lld clipping](inflect: true) will lose this tag. The clippings themselves stay.": {
      "comment": "Message of the delete confirmation. %lld is how many clippings carry the tag."
    },
    "clippings": {
      "comment": "Unit after the maximum-items field. Follows a number."
    },
    "days": {
      "comment": "Unit after the maximum-age field. Follows a number."
    },
    "esc": {
      "comment": "Keycap glyph. Printed on the key itself, never translated.",
      "shouldTranslate": false
    },
    "macOS refused the change: %@": {
      "comment": "Error under the login toggle. %@ is the system's own message."
    },
    "↑↓": {
      "comment": "Keycap glyph. Printed on the key itself, never translated.",
      "shouldTranslate": false
    },
    "⇧⌘": {
      "comment": "Keycap glyph. Printed on the key itself, never translated.",
      "shouldTranslate": false
    },
    "⌘1-9": {
      "comment": "Keycap glyph. Printed on the key itself, never translated.",
      "shouldTranslate": false
    },
    "⌘C": {
      "comment": "Keycap glyph. Printed on the key itself, never translated.",
      "shouldTranslate": false
    },
    "⌘N": {
      "comment": "Keycap glyph. Printed on the key itself, never translated.",
      "shouldTranslate": false
    },
    "⌘P": {
      "comment": "Keycap glyph. Printed on the key itself, never translated.",
      "shouldTranslate": false
    },
    "⌘R": {
      "comment": "Keycap glyph. Printed on the key itself, never translated.",
      "shouldTranslate": false
    },
