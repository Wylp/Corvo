{
  "sourceLanguage": "en",
  "strings": {
    "A tag named “%@” already exists.": {
      "comment": "Inline error in the tag editor when the name already belongs to another tag. %@ is the name the user typed."
    },
    "Accessibility granted": {
      "comment": "Status line when Corvo may paste for the user."
    },
    "Accessibility pending": {
      "comment": "Status line when Accessibility permission is missing."
    },
    "Add": {
      "comment": "Button that confirms the new tag in the tag sheet."
    },
    "Add app…": {
      "comment": "Button that opens a file picker to add an app to the blocklist."
    },
    "Add this tag to the clippings already in your history that match": {
      "comment": "Tooltip of the “Apply to existing…” button in the tag editor."
    },
    "Any app": {
      "comment": "Option in the tag editor's source picker: the rule is not restricted to one app."
    },
    "Applies itself": {
      "comment": "VoiceOver label of the bolt icon marking a tag in the list that carries a rule."
    },
    "Apply this rule to what you already copied?": {
      "comment": "Title of the confirmation before the tag is applied retroactively."
    },
    "Apply to existing…": {
      "comment": "Button in the tag editor that starts the retroactive apply. The ellipsis says it opens a confirmation first."
    },
    "Ask me to name what it catches": {
      "comment": "Toggle in the tag editor: offer to name a clipping this tag claims."
    },
    "Blocks nothing — not a bundle ID: %@": {
      "comment": "Warning under the blocklist. %@ is the quoted, comma-separated lines that are not bundle ids and are therefore enforcing nothing."
    },
    "Blue": {
      "comment": "Tag colour name. VoiceOver label of the colour swatch in the tag editor."
    },
    "Cancel": {
      "comment": "Button that dismisses the tag sheet or the rename sheet without changing anything."
    },
    "Choose": {
      "comment": "Confirmation button of that panel. Picks the app for the rule; it does not launch it."
    },
    "Choose an app…": {
      "comment": "Last row of the tag editor's source picker. Opens a panel listing every installed app. The ellipsis says a panel follows."
    },
    "Choose the app this rule should match.": {
      "comment": "Message shown inside the app panel opened from the tag editor."
    },
    "Close": {
      "comment": "Key-hint label for esc, which closes the panel."
    },
    "Copied, but not pasted": {
      "comment": "Alert title after Enter when Accessibility permission is missing: the item was copied but not pasted."
    },
    "Copy": {
      "comment": "Keycap rail label: ⌘C copies the selected clipping without pasting it."
    },
    "Copy something and come back.": {
      "comment": "Empty-history hint under the 'Nothing here yet' title."
    },
    "Corvo": {
      "comment": "App name. Never translated.",
      "shouldTranslate": false
    },
    "Corvo Settings": {
      "comment": "Title of the Settings window."
    },
    "Corvo needs Accessibility permission to paste straight into the app you were using. The content is already on your clipboard — paste it with ⌘V.\n\nIf Corvo is already switched on in that list, macOS is holding a permission for an older copy of the app: select Corvo, remove it with the − button, then add it again.": {
      "extractionState": "manual",
      "localizations": {}
    },
    "Corvo will keep the newest ^[%lld clipping](inflect: true) and delete anything older than ^[%lld day](inflect: true). Pinned and tagged clippings are never deleted. Corvo has no undo.": {
      "comment": "Body of the lowered-limit confirmation. First %lld is the item limit, second is the age limit in days."
    },
    "Could not save this tag. Nothing was changed.": {
      "comment": "Inline error next to the Save button when the write to the database failed."
    },
    "Delete": {
      "comment": "Key-hint label for the delete key, which removes the selected item."
    },
    "Delete after": {
      "comment": "Label of the field that sets how long a clipping is kept."
    },
    "Delete clippings now?": {
      "comment": "Title of the confirmation shown when the user lowers a retention limit."
    },
    "Delete tag": {
      "comment": "Tooltip and VoiceOver label of the − button under the tag list."
    },
    "Delete the tag “%@”?": {
      "comment": "Title of the delete confirmation. %@ is the tag's name."
    },
    "Done": {
      "comment": "Keycap rail label: esc closes the tag manager."
    },
    "Edit tags": {
      "comment": "Keycap rail label: ⌘⇧T opens the tag manager."
    },
    "Edit tags and rules": {
      "comment": "VoiceOver label of the sidebar button that opens the tag manager."
    },
    "Edit tags and rules (⌘⇧T)": {
      "comment": "Tooltip of the sidebar button that opens the tag manager."
    },
    "From app": {
      "comment": "Label of the tag editor field holding the source-app half of the rule."
    },
    "Green": {
      "comment": "Tag colour name. VoiceOver label of the colour swatch in the tag editor."
    },
    "History": {
      "comment": "Section title for the retention limits."
    },
    "Hold and click to select several": {
      "comment": "Key-hint label for ⇧⌘ in the panel's shortcut rail. Unlike the other hints, the key performs nothing on its own — it qualifies the click."
    },
    "Ignore": {
      "comment": "Confirmation button of the app picker. Adds the app to the blocklist."
    },
    "Ignored apps": {
      "comment": "Section title for the list of apps Corvo never records."
    },
    "Ignored apps, one bundle ID per line": {
      "comment": "VoiceOver label for the blocklist text editor."
    },
    "Image unavailable": {
      "comment": "Shown on a card whose image file could not be read from disk."
    },
    "Keep at most": {
      "comment": "Label of the field that sets the maximum number of clippings."
    },
    "Launch at login": {
      "comment": "Toggle that registers Corvo as a login item."
    },
    "Matches ^[%lld clipping](inflect: true) in your history.": {
      "comment": "Status under the pattern field. %lld is how many stored clippings the rule claims."
    },
    "Mint": {
      "comment": "Tag colour name. VoiceOver label of the colour swatch in the tag editor."
    },
    "Name": {
      "comment": "Label and placeholder of the tag name field, and of the clipping name field in the rename sheet."
    },
    "Name it": {
      "comment": "Button on the notification that reveals the text field for naming a clipping."
    },
    "Name this (⌘R)": {
      "comment": "Shown on a card whose rule tag asks for a name and that has none yet. ⌘R opens the rename sheet."
    },
    "Name this clipping": {
      "comment": "Title of the naming notification, and the heading of the ⌘R rename sheet."
    },
    "New": {
      "comment": "Keycap rail label: ⌘N makes a tag."
    },
    "New tag": {
      "comment": "Title of the sheet that adds a tag to the selected item."
    },
    "No matches": {
      "comment": "Title shown when the search finds nothing."
    },
    "No rule yet — this tag is only applied by hand.": {
      "comment": "Status under the pattern field when the tag carries no rule at all."
    },
    "No tags yet": {
      "comment": "Empty state of the tag list."
    },
    "Not a valid pattern. Check the brackets and escapes.": {
      "comment": "Status under the pattern field when the regular expression does not compile."
    },
    "Not now": {
      "comment": "Alert button that dismisses the missing-permission alert without opening Settings."
    },
    "Nothing here yet": {
      "comment": "Title shown when the history is empty."
    },
    "Nothing left to paste": {
      "extractionState": "manual",
      "localizations": {}
    },
    "Nothing you have copied matches yet. New copies still can.": {
      "comment": "Status under the pattern field when a valid rule matches nothing stored yet."
    },
    "OK": {
      "extractionState": "manual",
      "localizations": {}
    },
    "One bundle ID per line. Nothing copied in these apps is kept.": {
      "comment": "Caption under the blocklist."
    },
    "Open Login Items": {
      "comment": "Button that opens System Settings at the Login Items list."
    },
    "Open Settings": {
      "comment": "Alert button that opens System Settings at the Accessibility panel."
    },
    "Orange": {
      "comment": "Tag colour name. VoiceOver label of the colour swatch in the tag editor."
    },
    "Paste": {
      "comment": "Key-hint label for return, which pastes the selected item."
    },
    "Pasted %lld of %lld": {
      "comment": "Alert title when a multi-clipping paste only partly went through. First number is how many were pasted, second is how many were asked for."
    },
    "Pattern": {
      "comment": "Label and placeholder of the tag editor's regular-expression field."
    },
    "Permissions": {
      "comment": "Section title for the Accessibility permission status."
    },
    "Pin": {
      "comment": "Key-hint label for Command-P, which pins the selected item."
    },
    "Pink": {
      "comment": "Tag colour name. VoiceOver label of the colour swatch in the tag editor."
    },
    "Pinned": {
      "comment": "Accessibility label for the pin badge on a card."
    },
    "Pinned or tagged clippings never expire, and do not count towards the limit.": {
      "comment": "Caption under the retention fields."
    },
    "Press ⌘N to make one.": {
      "comment": "Second line of the empty tag list, naming the shortcut that creates a tag."
    },
    "Purple": {
      "comment": "Tag colour name. VoiceOver label of the colour swatch in the tag editor."
    },
    "Quit": {
      "comment": "Menu bar item that terminates the app."
    },
    "Red": {
      "comment": "Tag colour name. VoiceOver label of the colour swatch in the tag editor."
    },
    "Registered, but switched off in System Settings.": {
      "comment": "Warning under the login toggle when macOS has the item registered but disabled."
    },
    "Sample of matching clippings": {
      "comment": "VoiceOver label of the three-line preview of what the pattern matches."
    },
    "Save": {
      "comment": "Button in the tag editor that writes the tag, the ⏎ keycap rail label, and the button that saves a clipping's name from both the rename sheet and the notification."
    },
    "Save and apply": {
      "comment": "Button in the retroactive-apply confirmation: save the tag and tag the matches."
    },
    "Search content or app…": {
      "comment": "Placeholder of the search field at the top of the panel."
    },
    "Settings…": {
      "comment": "Menu bar item that opens the Settings window."
    },
    "Show History": {
      "comment": "Menu bar item that opens the floating panel."
    },
    "Shown on the card and searchable. Clear it to remove the name.": {
      "comment": "Helper text under the field in the ⌘R rename sheet."
    },
    "Sources": {
      "comment": "Sidebar section listing the apps the clippings came from."
    },
    "Tag": {
      "comment": "Key-hint label for Command-T, which tags the selected item."
    },
    "Tag name": {
      "comment": "Placeholder of the text field in the new-tag sheet."
    },
    "Tagged %@": {
      "comment": "Subtitle of the naming notification, saying which rule tag claimed the clipping. %@ is the tag name."
    },
    "Tags": {
      "comment": "Sidebar section listing the tags in use."
    },
    "That app carries no identifier, so no rule can name it. Choose another.": {
      "comment": "Inline error under the tag editor's source picker when the chosen app bundle has no bundle identifier to key the rule on."
    },
    "The clipboard holds one thing at a time, so several clippings go over joined into one. Images have no text to join, so they are left out — paste them one at a time.": {
      "comment": "Alert body explaining why images were left out of a multi-clipping paste."
    },
    "The file this clipping points at has been moved or deleted. Corvo keeps a reference to files rather than a copy of them, so there is nothing left to put on the clipboard.": {
      "extractionState": "manual",
      "localizations": {}
    },
    "The tag is saved and added to ^[%lld clipping](inflect: true) already in your history. Corvo has no undo.": {
      "comment": "Message of the retroactive-apply confirmation. %lld is how many clippings will be tagged."
    },
    "This pattern can take hours on some clippings. The cause is almost always a repeat wrapped in another repeat — (a+)+ or (\\s+)+ — where the inner + or * already covers the outer one. Remove the outer repeat.": {
      "comment": "Status under the pattern field when the regular expression compiles but backtracks catastrophically. It names the shape to look for and what to remove, because \"invalid pattern\" tells someone staring at a regex that compiles nothing they can act on."
    },
    "Try another word, or clear the search.": {
      "comment": "Hint under the 'No matches' title."
    },
    "Unavailable": {
      "comment": "Badge on a file card whose original file is no longer on disk."
    },
    "Unknown": {
      "comment": "Fallback shown on a card when the source app was not recorded."
    },
    "What is this?": {
      "comment": "Placeholder in the notification's text field, where the user types the name."
    },
    "Without it, Corvo copies but does not paste for you.": {
      "comment": "Caption under the Accessibility status."
    },
    "Yellow": {
      "comment": "Tag colour name. VoiceOver label of the colour swatch in the tag editor."
    },
    "^[%lld clipping](inflect: true) will lose this tag. The clippings themselves stay.": {
      "comment": "Message of the delete confirmation. %lld is how many clippings carry the tag."
    },
    "clippings": {
      "comment": "Unit after the maximum-items field. Follows a number."
    },
    "days": {
      "comment": "Unit after the maximum-age field. Follows a number."
    },
    "esc": {
      "comment": "Keycap glyph. Printed on the key itself, never translated.",
      "shouldTranslate": false
    },
    "macOS refused the change: %@": {
      "comment": "Error under the login toggle. %@ is the system's own message."
    },
    "⇧⌘": {
      "comment": "Keycap glyph. Printed on the key itself, never translated.",
      "shouldTranslate": false
    },
    "⌘C": {
      "comment": "Keycap glyph. Printed on the key itself, never translated.",
      "shouldTranslate": false
    },
    "⌘N": {
      "comment": "Keycap glyph. Printed on the key itself, never translated.",
      "shouldTranslate": false
    },
    "⌘P": {
      "comment": "Keycap glyph. Printed on the key itself, never translated.",
      "shouldTranslate": false
    },
    "⌘R": {
      "comment": "Keycap glyph. Printed on the key itself, never translated.",
      "shouldTranslate": false
    },
    "⌘T": {
      "comment": "Keycap glyph. Printed on the key itself, never translated.",
      "shouldTranslate": false
    },
    "⌘⇧T": {
      "comment": "Keycap glyph. Printed on the key itself, never translated.",
      "shouldTranslate": false
    },
    "⌘⌫": {
      "comment": "Keycap glyph. Printed on the key itself, never translated.",
      "shouldTranslate": false
    },
    "⏎": {
      "comment": "Keycap glyph. Printed on the key itself, never translated.",
      "shouldTranslate": false
    }
  },
  "version": "1.0"
}
